{
  "name": "Orbit Messenger",
  "short_name": "Orbit",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#08080A",
  "theme_color": "#08080A",
  "orientation": "portrait",
  "scope": "./",
  "share_target": {
    "action": "./_orbit-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "video/*",
            "audio/*",
            "application/*",
            "text/*"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "./orbit-icon.svg?v=brand-20261015",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
